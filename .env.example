# ── Required for deployment ────────────────────────────────────────────
# Set these in your deployment environment (Render, etc.).
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname   # or sqlite+aiosqlite:///data/cognitive_os.db
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# WEB_UI_PIN=your_pin_here
# WEB_UI_SESSION_SECRET=your_session_secret_here
# INSPECTOR_ADMIN_TOKEN=your_admin_token_here                # if empty, Inspector API returns 403
# ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# ── Optional: cookie security (default true in production) ─────────────
# WEB_UI_COOKIE_SECURE=true

# ── Telegram ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=[]

# ── Storage ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/cognitive_os.db
SNAPSHOT_PATH=data/state_snapshot.json

# ── Chaoxing (学习通) ──────────────────────────────────────────────────
CHAOXING_USERNAME=
CHAOXING_PASSWORD=
CHAOXING_MOCK=true
# Local Playwright storage state. Keep this file private and untracked.
CHAOXING_STATE_FILE=data/chaoxing_state.json

# ── JWXT (教务系统) ────────────────────────────────────────────────────
# Local credentials are used only to refresh an expired cookie automatically.
JWXT_USERNAME=
JWXT_PASSWORD=
JWXT_MOCK=true
JWXT_LOGIN_URL=https://jw.unn.edu.cn/xtgl/login_slogin.html
JWXT_SCHEDULE_YEAR=2025
JWXT_SCHEDULE_SEMESTER=12
JWXT_SEMESTER_START=2026-03-02
JWXT_SCHEDULE_WINDOW_DAYS=14
# Private local cookie cache. Keep this file untracked.
# Refresh interactively with: python scripts/refresh_jwxt_state.py
JWXT_COOKIES_PATH=data/jwxt_cookies.json
JWXT_HEADLESS=true

# ── Google Calendar ───────────────────────────────────────────────────
GOOGLE_CALENDAR_MOCK=true
GOOGLE_CALENDAR_CREDENTIALS_PATH=data/google_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=data/google_token.json
GOOGLE_CALENDAR_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Singapore
GOOGLE_CALENDAR_SYNC_WINDOW_DAYS=14
GOOGLE_CALENDAR_WRITE_ENABLED=false
GOOGLE_CALENDAR_WRITE_REQUIRES_ACCEPTANCE=true
GOOGLE_CALENDAR_SCHEDULE_WRITE_ENABLED=false
GOOGLE_CALENDAR_SCHEDULE_CALENDAR_ID=primary
GOOGLE_CALENDAR_SCHEDULE_SYNC_DAYS=7
GOOGLE_CALENDAR_POLL_INTERVAL_MINUTES=30

# ── DeepSeek (OpenAI-compatible Chat) ─────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30

SCHEDULE_DAILY_SYNC_TIMES=07:30,22:30
NIGHTLY_REVIEW_ENABLED=true
NIGHTLY_REVIEW_TIME=21:00
NIGHTLY_REVIEW_TIMEZONE=Asia/Singapore
NIGHTLY_REVIEW_USE_DEEPSEEK=false

# ── Momo / Vocabulary ─────────────────────────────────────────────────
MOMO_SYNC_PROJECT_PATH=
MOMO_CACHE_PATH=
MOMO_SYNC_ENABLED=true
MOMO_SYNC_INTERVAL_MINUTES=30
MOMO_STALE_AFTER_MINUTES=90
MOMO_SYNC_TIMEOUT_SECONDS=45
MOMO_SYNC_BLOCK_STARTUP=false
MOMO_EVENING_CHECK_TIME=21:30

# ── Scheduler ─────────────────────────────────────────────────────────
SCHEDULE_CHECK_INTERVAL_MINUTES=30
HOMEWORK_CHECK_INTERVAL_MINUTES=60
HOMEWORK_SYNC_INTERVAL_HOURS=12
SCHEDULE_SYNC_INTERVAL_HOURS=12
COGNITIVE_CHECKIN_INTERVAL_MINUTES=240

# ── Obsidian / Daily notes ────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=
OBSIDIAN_DAILY_FOLDER=daily
OBSIDIAN_DAILY_TEMPLATE_PATH=Templates/每日打卡模板.md
OBSIDIAN_DAILY_SINK_ENABLED=true
WORKOUT_UI_BASE_URL=
WORKOUT_UI_ACCESS_TOKEN=

# ── Art Planning ──────────────────────────────────────────────────────
ART_PLANNING_ENABLED=true
ART_DEFAULT_TARGET_MINUTES=360
ART_MINIMUM_KEEPALIVE_MINUTES=25
ART_CALENDAR_ID=primary
ART_MANAGED_CALENDAR_SOURCE=daily_art_plan
ART_VIBE_CODING_LIMIT_MINUTES=45

# ── Finance / Money Reality ───────────────────────────────────────────
FINANCE_MONTHLY_OUTING_BUDGET=250
FINANCE_MONTHLY_SAVINGS_TARGET=500
PARENT_REQUEST_SAFE_INTERVAL_DAYS=3
PARENT_REQUEST_SINGLE_RISK_THRESHOLD=75
PARENT_REQUEST_WEEKLY_RISK_THRESHOLD=300

# ── Web UI ────────────────────────────────────────────────────────────
WEB_UI_PIN=
WEB_UI_SESSION_SECRET=
WEB_UI_SESSION_DAYS=7
WEB_UI_COOKIE_SECURE=true

# ── Inspector API ─────────────────────────────────────────────────────
INSPECTOR_ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ── System ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DATA_DIR=data
